{
  "$schema": "https://unpkg.com/@changesets/config@3.1.3/schema.json",
  "changelog": [
    "@fingerprintjs/changesets-native-dependency-format",
    {
      "repo": "fingerprintjs/react-native",
      "packageName": "@fingerprint/react-native",
      "ios": {
        "podspecPath": "sdk/RNFingerprint.podspec",
        "dependencyName": "Fingerprint-iOS"
      },
      "android": {
        "path": "sdk/android",
        "gradleTaskName": "printFingerprintNativeSDKVersion"
      }
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": []
}
